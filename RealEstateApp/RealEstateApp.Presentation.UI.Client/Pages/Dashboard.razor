@page "/dashboard"
@inject HttpClient Http
@layout MainLayout

<h2 class="text-3xl font-bold mb-6">Admin Dashboard</h2>

<RadzenRow>
    <RadzenColumn Width="33%">
        <RadzenCard Style="background: linear-gradient(135deg, #1976d2, #42a5f5); color: white; padding: 20px; border-radius: 16px; box-shadow: 0 6px 15px rgba(0,0,0,0.15);">
            <div style="display: flex; align-items: center;">
                <div style="font-size: 30px; margin-right: 16px;">
                    <i class="material-icons">home_work</i>
                </div>
                <div>
                    <h4 class="text-lg font-medium mb-1">Total Estates</h4>
                    <p class="text-3xl font-bold">@stats?.TotalEstates</p>
                </div>
            </div>
        </RadzenCard>
    </RadzenColumn>

    <RadzenColumn Width="33%">
        <RadzenCard Style="background: linear-gradient(135deg, #d81b60, #f06292); color: white; padding: 20px; border-radius: 16px; box-shadow: 0 6px 15px rgba(0,0,0,0.15);">
            <div style="display: flex; align-items: center;">
                <div style="font-size: 30px; margin-right: 16px;">
                    <i class="material-icons">hourglass_top</i>
                </div>
                <div>
                    <h4 class="text-lg font-medium mb-1">Pending Estates</h4>
                    <p class="text-3xl font-bold">@stats?.PendingEstates</p>
                </div>
            </div>
        </RadzenCard>
    </RadzenColumn>

    <RadzenColumn Width="33%">
        <RadzenCard Style="background: linear-gradient(135deg, #43a047, #66bb6a); color: white; padding: 20px; border-radius: 16px; box-shadow: 0 6px 15px rgba(0,0,0,0.15);">
            <div style="display: flex; align-items: center;">
                <div style="font-size: 30px; margin-right: 16px;">
                    <i class="material-icons">group</i>
                </div>
                <div>
                    <h4 class="text-lg font-medium mb-1">Total Users</h4>
                    <p class="text-3xl font-bold">@stats?.TotalUsers</p>
                </div>
            </div>
        </RadzenCard>
    </RadzenColumn>
</RadzenRow>

<h3 class="text-2xl font-semibold mt-10 mb-4">System Overview</h3>

<RadzenChart Style="height: 400px;">
    <RadzenColumnSeries Data="@chartData" CategoryProperty="Label" ValueProperty="Value" Title="System Stats" />
    <RadzenCategoryAxis Padding="20" />
    <RadzenValueAxis />
</RadzenChart>

@code {
    StatsDto? stats;
    List<ChartItem> chartData = new();

    protected override async Task OnInitializedAsync()
    {
        stats = await Http.GetFromJsonAsync<StatsDto>("https://localhost:7044/api/dashboard/stats");

        chartData = new List<ChartItem>
        {
            new ChartItem { Label = "Total Estates", Value = stats.TotalEstates },
            new ChartItem { Label = "Pending Estates", Value = stats.PendingEstates },
            new ChartItem { Label = "Total Users", Value = stats.TotalUsers }
        };
    }

    public class StatsDto
    {
        public int TotalEstates { get; set; }
        public int PendingEstates { get; set; }
        public int TotalUsers { get; set; }
    }

    public class ChartItem
    {
        public string Label { get; set; } = string.Empty;
        public int Value { get; set; }
    }
}
